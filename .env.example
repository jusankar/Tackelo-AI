# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Settings > Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_ANSWER_MODEL: Default model for streaming interview answers.
# Suggested models: gemini-3.1-flash-lite (Fastest/High Quota), gemini-flash-latest (Balanced), gemini-3.8-flash (Detailed), gemini-4-argon (Complex Reasoning)
GEMINI_ANSWER_MODEL="gemini-3.1-flash-lite"

# GEMINI_AUDIO_MODEL: Default model for incoming interviewer voice transcription.
# Suggested models: gemini-3.5-transcribe (Dedicated Speech-to-Text), gemini-3.1-flash-lite (Fast Multimodal), gemini-flash-latest
GEMINI_AUDIO_MODEL="gemini-3.5-transcribe"

# GEMINI_TEMPERATURE: Controls response creativity (0.0 = deterministic, 0.3 = recommended for interviews).
GEMINI_TEMPERATURE="0.3"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

